 "daten": [],
 "unklarheiten": [
  "Was passiert nach einer Reklamation? Wird Ersatz geliefert oder endet der Prozess?",
  "Wie genau wird die Frist von zwei Wochen bei der Mittelabfrage gehandhabt? (Wir haben die Erinnerung in der Aufgabe 'Mittelabfrage durchführen' zusammengefasst, aber die Beschreibung deutet auf eine explizite Zeitsteuerung hin.)",
  "Ist die Kämmerei eine interne oder externe Stelle? (Wir haben sie als extern modelliert.)",
  "Wer erhält die Absage bei fehlenden Mitteln? (Wir haben einen Sequenzfluss zur Sachbearbeitung modelliert, aber die Absage könnte auch an die Teamleitung gehen.)"
 ],
 "nicht_modelliert": [
  "Die Teamleitung bindet bei IT-Sachen die IT ein und erhält eine Stellungnahme; dies wurde als Aufgabe 'IT-Stellungnahme einholen' modelliert, ohne die IT als eigene Rolle.",
  "Die Vergabestelle sendet bei der Mittelabfrage eine Erinnerung, wenn keine Antwort nach zwei Wochen; diese Details sind in der Aufgabe 'Mittelabfrage durchführen' enthalten.",
  "Die Absage bei fehlenden Mitteln wird an den Fachbereich gesendet; modelliert als Sequenzfluss zur Sachbearbeitung."
 ]
}