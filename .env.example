# Vorlage für die Umgebungsvariablen. Kopieren nach .env und Werte eintragen.
# .env wird nie eingecheckt.

# Pflicht: Passwort für die Anmeldung
APP_PASSWORD=

# Pflicht: Schlüssel für OpenRouter (nur Testprozesse, keine echten Kundendaten)
OPENROUTER_API_KEY=

# Empfohlen: lange zufällige Zeichenfolge, sonst nach jedem Neustart neu anmelden
SESSION_SECRET=

# Optional: schaltet "Mistral Small (direkt bei Mistral, EU)" frei
MISTRAL_API_KEY=

# Optional: Myra AI Workspace (EU). Beide Werte nötig, dann erscheinen die Myra-Modelle.
# Adresse mit Mandant und Gateway aus dem Myra-Workspace, z. B. https://ai.myra.eu/v1/<mandant>/<gateway>/compat
MYRA_BASE_URL=
MYRA_API_KEY=
# Optional: am Myra-Gateway freigeschaltete Modelle, kommagetrennt (ohne Angabe: qwen3.8-27b, mistral-small-4, gemma-4-31b-it)
# MYRA_MODELLE=claude-haiku-4-5

# Optional: Spracherkennung auf dem eigenen Server (Whisper mit OpenAI-kompatibler Schnittstelle).
# Gesetzt: Aufnahme im Browser, Erkennung über den Server, Audio verlässt den Server nicht.
# Leer: Spracherkennung des Browsers (Chrome, Audio geht an Google, nur Testprozesse).
# WHISPER_BASE_URL=http://10.0.0.1:8088
# Optional: Modell-ID für den Whisper-Dienst (ohne Angabe sein voreingestelltes Modell)
# WHISPER_MODEL=
# Optional: Fachwörter oder Zusammenhang als Hilfe für die Erkennung (Standard: Verwaltungsbegriffe, siehe server/config.js)
# WHISPER_PROMPT=
# WHISPER_TIMEOUT_MS=120000

# Optional: eigene Modellliste als JSON, Struktur siehe server/config.js
# MODELS_JSON=

# Optional: Voreinstellungen
# PORT=3000
# DATA_DIR=./data
# LLM_TIMEOUT_MS=180000
