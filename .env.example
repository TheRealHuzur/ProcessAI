# Vorlage für die Umgebungsvariablen. Kopieren nach .env und Werte eintragen.
# .env wird nie eingecheckt.

# Pflicht: Passwort für die Anmeldung
APP_PASSWORD=

# Pflicht: Schlüssel für OpenRouter (nur Testprozesse, keine echten Kundendaten)
OPENROUTER_API_KEY=

# Empfohlen: lange zufällige Zeichenfolge, sonst nach jedem Neustart neu anmelden
SESSION_SECRET=

# Optional: schaltet "Mistral Small (direkt bei Mistral, EU)" frei
MISTRAL_API_KEY=

# Optional: Myra AI Workspace (EU). Beide Werte nötig, dann erscheinen die Myra-Modelle.
# Adresse mit Mandant und Gateway aus dem Myra-Workspace, z. B. https://ai.myra.eu/v1/<mandant>/<gateway>/compat
MYRA_BASE_URL=
MYRA_API_KEY=

# Optional: eigene Modellliste als JSON, Struktur siehe server/config.js
# MODELS_JSON=

# Optional: Voreinstellungen
# PORT=3000
# DATA_DIR=./data
# LLM_TIMEOUT_MS=180000
