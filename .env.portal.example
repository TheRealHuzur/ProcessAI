# Vorlage für die Umgebungsvariablen des Kundenportals (Dockerfile.portal, eigener Container).
# Das Portal braucht und bekommt keine KI-Schlüssel. Werte nie einchecken.

# Pflicht: Passwort für die Verwaltung unter /verwaltung/ (Mandanten anlegen, Module freischalten)
PORTAL_ADMIN_PASSWORT=

# Empfohlen: lange zufällige Zeichenfolge, sonst nach jedem Neustart neu anmelden.
# Eigener Wert, nicht derselbe wie beim ProzessPiloten. Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# Optional: Voreinstellungen
# PORT=3000
# DATA_DIR=/data
# SESSION_DAYS=30
